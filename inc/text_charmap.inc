NEWCHARMAP gbc_remote_text

CHARMAP " ", GLYPH_SPACE
CHARMAP "=", GLYPH_EQUALS
CHARMAP "?", GLYPH_QUESTION
CHARMAP ".", GLYPH_DOT
CHARMAP "-", GLYPH_DASH
CHARMAP ":", GLYPH_COLON
CHARMAP ">", GLYPH_CURSOR
CHARMAP "!", GLYPH_EXCLAMATION
CHARMAP "_", GLYPH_UNDERSCORE
CHARMAP "/", GLYPH_SLASH

FOR letterIndex, 26
    CHARMAP STRSLICE("ABCDEFGHIJKLMNOPQRSTUVWXYZ", letterIndex, letterIndex + 1), GLYPH_LETTER_A + letterIndex
ENDR

FOR digitIndex, 10
    CHARMAP STRSLICE("0123456789", digitIndex, digitIndex + 1), GLYPH_DIGIT_0 + digitIndex
ENDR
