DEF CPU_SPEED_NORMAL EQU 0
DEF CPU_SPEED_DOUBLE EQU 1

IF !DEF(SELECTED_CPU_SPEED)
DEF SELECTED_CPU_SPEED EQU CPU_SPEED_DOUBLE
ENDC

DEF SLOT_COUNT   EQU 8
DEF NAME_LENGTH  EQU 8

DEF DIRECTORY_BANK             EQU 0
DEF FIRST_SAMPLE_BANK          EQU 1
DEF DIRECTORY_SIGNATURE_LENGTH EQU 4
DEF DIRECTORY_ENTRY_SIZE_BYTES EQU 1 + NAME_LENGTH
DEF DIRECTORY_ENTRIES_BYTES    EQU SLOT_COUNT * DIRECTORY_ENTRY_SIZE_BYTES
DEF DIRECTORY_CHECKSUM_LENGTH  EQU 1
DEF DIRECTORY_SIZE_BYTES       EQU DIRECTORY_SIGNATURE_LENGTH + DIRECTORY_ENTRIES_BYTES + DIRECTORY_CHECKSUM_LENGTH
DEF DIRECTORY_CHECKSUMMED_BYTES EQU DIRECTORY_SIZE_BYTES - DIRECTORY_CHECKSUM_LENGTH
DEF DIRECTORY_CHECKSUM_SEED    EQU $C3

DEF ENTRY_STATUS_FREE EQU $00
DEF ENTRY_STATUS_USED EQU $A5

DEF NO_USED_ENTRIES  EQU 0
DEF HAS_USED_ENTRIES EQU 1

DEF SAMPLE_BANK_SIGNATURE   EQU $5A
DEF SAMPLE_SIGNATURE_ADDRESS EQU SRAM_END_ADDRESS - 1

DEF MINIMUM_SIGNAL_TRANSITIONS EQU 8

DEF SAMPLES_PER_BYTE              EQU 8
DEF SAMPLE_PAGE_COUNT             EQU 16
DEF SAMPLE_PAGE_SIZE_BYTES        EQU 256
DEF SAMPLE_BUFFER_SIZE_BYTES      EQU SAMPLE_PAGE_COUNT * SAMPLE_PAGE_SIZE_BYTES
DEF SAMPLE_BUFFER_ADDRESS         EQU $D000
DEF SAMPLE_BUFFER_END_HIGH_BYTE   EQU HIGH(SAMPLE_BUFFER_ADDRESS + SAMPLE_BUFFER_SIZE_BYTES)

DEF LIST_ACTION_NEW    EQU 1
DEF LIST_ACTION_SEND   EQU 2
DEF LIST_ACTION_DELETE EQU 3

DEF JINGLE_NOTE_END EQU 0

DEF DIAGNOSTIC_BANK_COUNT  EQU SLOT_COUNT + 1
DEF DIAGNOSTIC_PATTERN_KEY EQU $5C
DEF DIAGNOSTIC_BANK_OK     EQU 0
DEF DIAGNOSTIC_BANK_BAD    EQU 1
