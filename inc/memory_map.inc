DEF ROM_ENTRY_POINT EQU $0100
DEF ROM_HEADER_END  EQU $0150

DEF VRAM_TILE_DATA_BASE       EQU $8000
DEF BACKGROUND_MAP_BASE       EQU $9800
DEF BACKGROUND_MAP_SIZE_BYTES EQU 1024
DEF BACKGROUND_MAP_ROW_STRIDE EQU 32

DEF SRAM_BASE_ADDRESS    EQU $A000
DEF SRAM_END_ADDRESS     EQU $C000
DEF SRAM_BANK_SIZE_BYTES EQU SRAM_END_ADDRESS - SRAM_BASE_ADDRESS
DEF SRAM_END_HIGH_BYTE   EQU HIGH(SRAM_END_ADDRESS)

DEF MBC5_RAM_ENABLE_REGISTER EQU $0000
DEF MBC5_RAM_BANK_REGISTER   EQU $4000
DEF MBC5_RAM_ENABLE_VALUE    EQU $0A
DEF MBC5_RAM_DISABLE_VALUE   EQU $00

DEF STACK_SIZE_BYTES EQU 64
