DEF TEST_PASSED              EQU 0
DEF TEST_NOT_RUN             EQU $FF
DEF TEST_RUN_FINISHED_MARKER EQU $A5
DEF MAXIMUM_TEST_COUNT       EQU 64
DEF TEST_STACK_SIZE_BYTES    EQU 128

DEF TEST_BLANK_SRAM_BYTE      EQU $00
DEF TEST_SAMPLE_FILL_BYTE     EQU $3C
DEF TEST_SAMPLE_FIRST_BYTE    EQU $11
DEF TEST_SAMPLE_LAST_BYTE     EQU $22
DEF TEST_PATTERN_SLOT_ZERO    EQU $11
DEF TEST_PATTERN_SLOT_ONE     EQU $22
DEF TEST_PATTERN_SLOT_TWO     EQU $33
DEF TEST_SIGNALS_PER_CARD_SHIFT EQU 3
DEF TEST_CARDS_FOR_FULL_POOL  EQU 4
DEF TEST_PROBE_WIPED_BANK     EQU 3
DEF TEST_BANKS_ONE            EQU 1
DEF TEST_BANKS_FOUR           EQU 4
DEF TEST_BANKS_EIGHT          EQU 8

DEF assertionNumber = 0

MACRO ExpectEqual
    cp \1
    jr z, .assertionPassed\@
    DEF assertionNumber += 1
    ld a, assertionNumber
    ret
.assertionPassed\@
ENDM

MACRO ExpectZero
    ExpectEqual 0
ENDM

MACRO TestPassed
    ld a, TEST_PASSED
    ret
ENDM

MACRO RegisterTest
TestEntry_\1:
    dw \1
ENDM
